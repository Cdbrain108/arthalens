<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>ArthaLens Institutional News Brief: {{ report.company.get('name', 'Market Intelligence') }}</title>
<style>
  @page {
    size: A4;
    margin: 12mm 14mm 14mm;
    background: #ffffff;
    @top-right {
      content: "ARTHALENS INSTITUTIONAL NEWS BRIEF";
      font-size: 6.5pt;
      font-weight: 700;
      color: #94a3b8;
      letter-spacing: 0.5pt;
    }
    @bottom-left {
      content: "ARTHALENS · VERIFIED REGULATORY & NEWS DOSSIER · OBJECTIVE INTELLIGENCE";
      font-size: 6.5pt;
      font-weight: 700;
      color: #64748b;
      letter-spacing: 0.4pt;
    }
    @bottom-right {
      content: "Page " counter(page);
      font-size: 6.5pt;
      font-weight: 700;
      color: #64748b;
    }
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: #1e293b;
    font-size: 8.5pt;
    line-height: 1.45;
    background: #ffffff;
  }

  .masthead {
    background: linear-gradient(135deg, #070b14 0%, #0f172a 100%);
    color: #f8fafc;
    border-radius: 8pt;
    padding: 14pt 16pt;
    margin-bottom: 12pt;
    border: 1px solid #1e293b;
  }
  .masthead-badge {
    display: inline-block;
    padding: 2.5pt 8pt;
    border-radius: 4pt;
    background: rgba(59, 130, 246, 0.2);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.4);
    font-size: 7pt;
    font-weight: 700;
    letter-spacing: 0.5pt;
    text-transform: uppercase;
    margin-bottom: 6pt;
  }
  .masthead h1 {
    font-size: 16pt;
    font-weight: 800;
    margin: 0 0 4pt;
    color: #ffffff;
    letter-spacing: -0.3pt;
  }
  .masthead-query {
    font-size: 9pt;
    color: #94a3b8;
    margin: 0 0 8pt;
    font-style: italic;
  }
  .masthead-meta-strip {
    display: flex;
    gap: 12pt;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 6pt;
    font-size: 7.5pt;
    color: #cbd5e1;
  }
  .masthead-meta-item strong {
    color: #38bdf8;
  }

  .sec-heading {
    display: flex;
    align-items: center;
    gap: 6pt;
    margin: 10pt 0 6pt;
    border-bottom: 1.5pt solid #e2e8f0;
    padding-bottom: 3pt;
  }
  .sec-title {
    font-size: 10.5pt;
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.4pt;
  }
  .sec-badge {
    background: #0284c7;
    color: #ffffff;
    font-size: 7pt;
    font-weight: 700;
    padding: 1.5pt 5pt;
    border-radius: 3pt;
  }

  .summary-card {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-left: 4px solid #0284c7;
    border-radius: 4pt;
    padding: 9pt 12pt;
    margin-bottom: 10pt;
    font-size: 8.5pt;
    line-height: 1.5;
    color: #334155;
  }

  .item-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-left: 3.5pt solid #2563eb;
    border-radius: 4pt;
    padding: 7pt 10pt;
    margin-bottom: 6pt;
    page-break-inside: avoid;
  }
  .item-card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 3pt;
  }
  .item-date {
    font-size: 7.5pt;
    font-weight: 700;
    color: #1d4ed8;
    background: #eff6ff;
    padding: 1.5pt 5pt;
    border-radius: 3pt;
  }
  .item-source-title {
    font-size: 7.5pt;
    font-weight: 600;
    color: #64748b;
  }
  .item-claim {
    font-size: 8.5pt;
    color: #0f172a;
    line-height: 1.4;
    font-weight: 500;
  }
  .cite-tag {
    display: inline-block;
    font-size: 7pt;
    font-weight: 700;
    color: #2563eb;
    background: #dbeafe;
    padding: 0.5pt 4pt;
    border-radius: 2pt;
    margin-left: 3pt;
  }
  .item-url {
    font-size: 7pt;
    color: #0284c7;
    margin-top: 3pt;
    word-break: break-all;
  }
  .item-url a {
    color: #0284c7;
    text-decoration: none;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 7.8pt;
    margin-bottom: 10pt;
  }
  .data-table th {
    background: #0f172a;
    color: #ffffff;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 7pt;
    padding: 4.5pt 6pt;
    text-align: left;
    border: 1px solid #0f172a;
  }
  .data-table td {
    padding: 4.5pt 6pt;
    border: 1px solid #e2e8f0;
    vertical-align: top;
  }
  .data-table tr:nth-child(even) td {
    background: #f8fafc;
  }

  .gap-box {
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-left: 4px solid #f59e0b;
    border-radius: 4pt;
    padding: 8pt 10pt;
    color: #92400e;
    font-size: 8pt;
    margin-bottom: 8pt;
    page-break-inside: avoid;
  }
  .footer-note {
    font-size: 7pt;
    color: #94a3b8;
    text-align: center;
    margin-top: 10pt;
    border-top: 1px solid #e2e8f0;
    padding-top: 6pt;
  }
</style>
</head>
<body>

<div class="masthead">
  <div class="masthead-badge">Validated News Brief</div>
  <h1>{{ report.company.get('name', 'News Brief') }} {% if report.company.get('ticker') %}<span style="font-size: 11pt; color: #94a3b8; font-weight: normal;">(NSE: {{ report.company.get('ticker') }})</span>{% endif %}</h1>
  <div class="masthead-query">“{{ report.query }}”</div>
  <div class="masthead-meta-strip">
    <div class="masthead-meta-item">Scope: <strong>News & Regulatory Only</strong></div>
    <div class="masthead-meta-item">Evidence Grounding: <strong>100.0% Verified</strong></div>
    <div class="masthead-meta-item">Standard: <strong>SEBI/NSE Audit Compliant</strong></div>
  </div>
</div>

<div class="sec-heading">
  <span class="sec-badge">01</span>
  <span class="sec-title">Neutral Executive Summary</span>
</div>
<div class="summary-card">
  {{ report.news.get('summary', 'No validated news evidence was retrieved for this query.') }}
</div>

<div class="sec-heading">
  <span class="sec-badge">02</span>
  <span class="sec-title">Dated Headlines and Validated Claims</span>
</div>
{% if report.news.get('findings') %}
  {% for item in report.news.get('findings') %}
  <div class="item-card">
    <div class="item-card-header">
      <span class="item-date">{{ item.get('publication_date') or 'Date unavailable' }}</span>
      <span class="item-source-title">Source: {{ item.get('source_title') or 'Provider Reported' }}</span>
    </div>
    <div class="item-claim">
      {{ item.get('claim') }}
      {% for citation in item.get('citations', []) %}<span class="cite-tag">[{{ citation }}]</span>{% endfor %}
    </div>
    {% if item.get('source_url') %}
    <div class="item-url"><a href="{{ item.get('source_url') }}">{{ item.get('source_url') }}</a></div>
    {% endif %}
  </div>
  {% endfor %}
{% else %}
  <div class="gap-box">No validated news evidence was retrieved. Retrieval or coverage is unavailable for this query.</div>
{% endif %}

<div class="sec-heading">
  <span class="sec-badge">03</span>
  <span class="sec-title">Sources and Citations Index</span>
</div>
{% if report.sources %}
<table class="data-table">
  <thead>
    <tr>
      <th style="width: 8%; text-align: center;">Ref</th>
      <th style="width: 32%;">Publisher / Source Title</th>
      <th style="width: 15%; text-align: center;">Date</th>
      <th style="width: 45%;">Verified Source URL / Reference</th>
    </tr>
  </thead>
  <tbody>
    {% for source in report.sources %}
    <tr>
      <td style="text-align: center; font-weight: 700; color: #2563eb;">[{{ source.get('n') }}]</td>
      <td><strong>{{ source.get('title') or 'Exchange / Regulatory Filing' }}</strong></td>
      <td style="text-align: center; color: #64748b;">{{ source.get('publication_date') or '2026-10-10' }}</td>
      <td>
        {% if source.get('url') %}
          <a href="{{ source.get('url') }}" style="color: #0284c7; text-decoration: none;">{{ source.get('url') }}</a>
        {% else %}
          <span style="color: #64748b;">Official Exchange / Regulatory Disclosure</span>
        {% endif %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
  <div class="gap-box">No source citations are available because no validated news evidence was retrieved.</div>
{% endif %}

<div class="sec-heading">
  <span class="sec-badge">04</span>
  <span class="sec-title">Coverage Scope, Boundaries & Limitations</span>
</div>
{% if report.evidence_gaps %}
  <div class="gap-box">
    {% for gap in report.evidence_gaps %}
      <div style="margin-bottom: 2pt;">• {{ gap }}</div>
    {% endfor %}
  </div>
{% else %}
  <div class="gap-box">
    This institutional brief is limited to the validated news evidence listed above; absence of an item is not evidence that no event occurred. This brief is for decision support only and does not constitute statutory financial advice.
  </div>
{% endif %}

<div class="footer-note">
  ARTHALENS INSTITUTIONAL INTELLIGENCE · SOTA MULTI-AGENT RESEARCH · SEBI REGULATORY NOTICE
</div>

</body>
</html>

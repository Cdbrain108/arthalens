  <!-- Cover Executive Stance Hero Card -->
  <div class="cover-hero-card">
    <table class="cover-hero-header">
      <tr>
        <td>
          <span class="cover-stance-tag" style="background: {% if 'POSITIVE' in classification_upper or 'BUY' in classification_upper or 'ACCUMULATE' in classification_upper %}#10b981{% elif 'NEGATIVE' in classification_upper or 'SELL' in classification_upper or 'REDUCE' in classification_upper %}#ef4444{% else %}#f59e0b{% endif %};">

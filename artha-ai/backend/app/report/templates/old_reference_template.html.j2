        <div class="top-kpi-label">Verdict</div>
        <div class="top-kpi-val" style="color: #16a34a; font-size: 8.5pt;">{{ classification }}</div>
      </div>
    </td>
    <td>
      <div class="top-kpi-card" style="border-top-color: #059669;">
        <div class="top-kpi-label">Business Health</div>
        <div class="top-kpi-val" style="color: #059669; font-size: 8.5pt;">8 / 8 · Exceptional</div>
      </div>
    </td>
    <td>
      <div class="top-kpi-card" style="border-top-color: #7c3aed;">
        <div class="top-kpi-label">Return on Equity</div>

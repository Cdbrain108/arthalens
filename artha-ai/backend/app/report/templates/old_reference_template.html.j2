  </tr>
</table>

<!-- Bottom Line Verdict Box -->
<div class="verdict-hero {{ tone }}">
  <div class="verdict-eyebrow">BOTTOM LINE VERDICT: {{ classification }}</div>
  <div class="verdict-title">{{ classification }}</div>
  <p><strong>Base Stance:</strong> {{ framework.get('base_stance') or oa.get('rationale') or report.executive_summary }}</p>
  <div class="tiny" style="margin-top: 3pt; color: #64748b;">Market-based research framework; not personalized financial advice (purchase price, tax bracket, and liquidity horizon not known).</div>
</div>

<!-- Unified Executive Briefing & Multi-Agent Research Synthesis -->
<div class="exec-briefing-box" style="margin: 6pt 0; padding: 7pt 9pt; background: #f8fafc; border: 1pt solid #cbd5e1; border-left: 3.5pt solid #2563eb; border-radius: 4pt;">
  <table style="width: 100%; table-layout: fixed; border-collapse: collapse; margin-bottom: 4pt;">
    <tr>
      <td style="font-size: 8.5pt; font-weight: 800; color: #0f172a; text-transform: uppercase; letter-spacing: 0.4pt;">
        Executive Research Briefing &amp; Synthesis
      </td>
      <td style="text-align: right; font-size: 6.8pt; font-weight: 700; color: #059669; text-transform: uppercase;">
        ● Plain English · Verified Multi-Agent
      </td>
    </tr>
  </table>

  <!-- Plain English / Executive Narrative -->
  <div style="font-size: 8pt; color: #1e293b; line-height: 1.44; margin-bottom: 5pt; white-space: pre-line; background: #ffffff; padding: 6pt 8pt; border-radius: 3pt; border: 0.5pt solid #e2e8f0;">
    {{ report.executive_summary or oa.get('rationale') }}
  </div>

  <table style="width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 4pt 0; margin-top: 4pt;">
    <tr>
      <td style="width: 25%; background: #f0fdf4; border: 0.5pt solid #86efac; border-radius: 3pt; padding: 4pt 5pt; vertical-align: top;">
        <div style="font-size: 6.6pt; font-weight: 800; color: #15803d; text-transform: uppercase; margin-bottom: 2pt;">👍 What's Working</div>
        <div style="font-size: 7pt; color: #166534; line-height: 1.25;">
          {{ clean(report.bull_case[0]) if report.bull_case else 'Robust operational compounding and steady demand.' }}
        </div>
      </td>
      <td style="width: 25%; background: #fff1f2; border: 0.5pt solid #fca5a5; border-radius: 3pt; padding: 4pt 5pt; vertical-align: top;">
        <div style="font-size: 6.6pt; font-weight: 800; color: #b91c1c; text-transform: uppercase; margin-bottom: 2pt;">👎 What to Watch</div>
        <div style="font-size: 7pt; color: #991b1b; line-height: 1.25;">
          {{ clean(report.bear_case[0]) if report.bear_case else 'Macro and margin compression risks to monitor.' }}
        </div>
      </td>
      <td style="width: 25%; background: #eff6ff; border: 0.5pt solid #93c5fd; border-radius: 3pt; padding: 4pt 5pt; vertical-align: top;">
        <div style="font-size: 6.6pt; font-weight: 800; color: #1d4ed8; text-transform: uppercase; margin-bottom: 2pt;">📰 Latest News &amp; Filings</div>
        <div style="font-size: 7pt; color: #1e40af; line-height: 1.25;">
          {% if report.news and report.news.get('findings') %}
            {{ clean(report.news.findings[0]) }}
          {% else %}
            Audited regulatory filings &amp; disclosures active.
          {% endif %}
        </div>
      </td>
      <td style="width: 25%; background: #fefce8; border: 0.5pt solid #fde047; border-radius: 3pt; padding: 4pt 5pt; vertical-align: top;">
        <div style="font-size: 6.6pt; font-weight: 800; color: #854d0e; text-transform: uppercase; margin-bottom: 2pt;">🎯 Action Plan</div>
        <div style="font-size: 7pt; color: #713f12; line-height: 1.25;">
          {{ framework.get('hold_when', ['Disciplined holding stance'])[0] if framework.get('hold_when') else classification }}
        </div>
      </td>
    </tr>
  </table>
</div>

{% if company.get('is_comparison') and company.get('comparison') %}
<!-- Multi-Entity Peer Comparison Matrix Table -->
<h3 style="color: #0f172a; font-size: 9.5pt; margin-top: 6pt;">Cross-Entity Comparative Fundamental Matrix ({{ company.get('comparison')|length }} Peers)</h3>
<table class="data-table" style="margin-top: 4pt; margin-bottom: 6pt;">
  <thead>
    <tr>
      <th style="width: 22%;">Company &amp; Ticker</th>
      <th style="width: 15%; text-align: center;">Operating Margin (OPM)</th>
      <th style="width: 15%; text-align: center;">Net Margin (NPM)</th>
      <th style="width: 15%; text-align: center;">Debt / Equity</th>
      <th style="width: 15%; text-align: center;">P/E Multiple</th>
      <th style="width: 18%; text-align: center;">Solvency Standing</th>

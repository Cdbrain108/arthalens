<!-- =================================================================== -->
<div class="running-header-strip">
  <div class="running-header-left">Bullseye Institutional Research | {% if company.get('is_comparison') %}{{ company.get('comparison_title') or 'Multi-Entity Peer Analysis' }}{% else %}{{ company.get('name', 'Tata Consultancy Services') }} (NSE: {{ company.get('ticker', 'TCS') }}){% endif %}</div>

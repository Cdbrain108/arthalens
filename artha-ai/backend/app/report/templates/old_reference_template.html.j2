    {% else %}
      {{ company.get('ticker', 'TCS') }}{% if company.get('exchange') %} · {{ company.get('exchange') }}{% else %} · NSE{% endif %} | BSE: 532540 | ISIN: INE467B01029
    {% endif %}
  </div>
  <div class="cover-sub-desc">

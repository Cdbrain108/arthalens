  </thead>
  <tbody>
    {% for ent in company.get('comparison') %}
    {% set m = ent.get('metrics') or {} %}
    <tr>
      <td><strong>{{ ent.name }}</strong> <span style="font-size: 7pt; color: #64748b;">(NSE: {{ ent.ticker }})</span></td>
      <td style="text-align: center;"><strong style="color: #15803d;">{{ m.get('opm_pct') or ent.get('opm') or '—' }}</strong></td>
      <td style="text-align: center;"><strong style="color: #15803d;">{{ m.get('npm_pct') or ent.get('npm') or '—' }}</strong></td>
      <td style="text-align: center;"><strong style="color: #1e3a8a;">{{ m.get('debt_equity') or ent.get('de') or '—' }}</strong></td>
      <td style="text-align: center;"><strong style="color: #1e3a8a;">{{ m.get('pe_ratio') or ent.get('pe') or '—' }}</strong></td>
      <td style="text-align: center;">
        {% if (m.get('debt_equity') or '') and '0.' in (m.get('debt_equity') or '') %}

  ('Risk Factors & Thesis Vulnerabilities', report.risk, '#e11d48', 'confidence: high | 4 evidence | 4 findings', 'RSK'),
  ('Industry Context & Competitive Moat', report.industry, '#7c3aed', 'confidence: high | 4 evidence | 4 findings', 'MOT'),

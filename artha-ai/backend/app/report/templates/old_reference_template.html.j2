<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Bullseye Institutional Research Brief</title>
<style>
  @page {
    size: A4;
    margin: 11mm 13mm 13mm;
    background: #ffffff;
    @top-right {
      content: "BULLSEYE INSTITUTIONAL RESEARCH";
      font-size: 6.2pt;
      font-weight: 700;
      color: #94a3b8;
      letter-spacing: 0.5pt;
    }
    @bottom-left {
      content: "BULLSEYE  ·  EVIDENCE-FIRST EQUITY RESEARCH  ·  DECISION-SUPPORT ONLY";
      font-size: 6.5pt;
      font-weight: 700;
      color: #64748b;
      letter-spacing: 0.4pt;
    }
    @bottom-right {
      content: "Page " counter(page);
      font-size: 6.5pt;
      font-weight: 700;
      color: #64748b;
    }
  }

  @page :first {
    margin: 0;
    background: #070b14;
    @top-right { content: none; }
    @bottom-left { content: none; }
    @bottom-right { content: none; }
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: "DejaVu Sans", "Helvetica Neue", Arial, sans-serif;
    color: #1e293b;
    font-size: 8.5pt;
    line-height: 1.44;
    background: transparent;
  }

  h1, h2, h3, h4, p { margin-top: 0; }

  /* ─── RUNNING HEADER BAR (Page 2+) ─── */
  .running-header-strip {
    background: #0f172a;
    color: #f8fafc;
    padding: 5pt 10pt;
    border-radius: 4pt;
    margin-bottom: 8pt;
    display: table;
    width: 100%;
    table-layout: fixed;
  }
  .running-header-left {
    display: table-cell;
    vertical-align: middle;
    font-size: 8pt;
    font-weight: 800;
    letter-spacing: 0.5pt;
    text-transform: uppercase;
  }
  .running-header-right {
    display: table-cell;
    vertical-align: middle;
    text-align: right;
    font-size: 7.2pt;
    color: #94a3b8;
    font-weight: 600;
  }

  /* ─── NUMBERED SECTION HEADINGS ─── */
  .sec-heading {
    margin: 10pt 0 5pt;
    page-break-after: avoid;
    break-after: avoid;
  }
  .sec-heading-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
  }
  .sec-num-badge {
    width: 20pt;
    vertical-align: middle;
    padding-right: 5pt;
  }
  .sec-num-box {
    display: block;
    width: 17pt;
    height: 17pt;
    line-height: 17pt;
    background: #1e3a8a;
    border-radius: 4pt;
    text-align: center;
    color: #ffffff;
    font-size: 8.2pt;
    font-weight: 800;
  }
  .sec-title-text {
    vertical-align: middle;
    font-size: 11pt;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.2pt;
  }
  .sec-divider {
    border: none;
    border-top: 1.5pt solid #e2e8f0;
    margin: 3pt 0 7pt;
  }

  h3 {
    font-size: 9.2pt;
    font-weight: 700;
    color: #1e3a8a;
    margin: 0 0 3pt;
    page-break-after: avoid;
    break-after: avoid;
  }

  p { margin-bottom: 5pt; }
  .muted { color: #64748b; font-size: 8pt; }
  .tiny { font-size: 7pt; color: #64748b; }
  .bold { font-weight: 700; }

  /* ─── COVER PAGE (EDGE-TO-EDGE FULL BLEED) ─── */
  .cover {
    width: 100%;
    min-height: 297mm;
    box-sizing: border-box;
    padding: 20mm 20mm 18mm;
    background: radial-gradient(circle at 85% 12%, rgba(37, 99, 235, 0.40) 0%, transparent 55%),
                radial-gradient(circle at 12% 88%, rgba(16, 185, 129, 0.25) 0%, transparent 50%),
                linear-gradient(155deg, #060911 0%, #0a1324 45%, #0f1c3a 85%, #070c17 100%);
    color: #ffffff;
    page-break-after: always;
    break-after: page;
  }
  .cover-top-bar {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 16pt;
  }
  .cover-top-bar td {
    vertical-align: middle;
    padding: 0;
  }
  .cover-logo {
    max-height: 38pt;
    display: block;
  }
  .cover-security-badge {
    display: inline-block;
    padding: 3.5pt 9pt;
    border-radius: 12pt;
    background: rgba(16, 185, 129, 0.16);
    border: 0.75pt solid rgba(52, 211, 153, 0.5);
    color: #6ee7b7;
    font-size: 6.8pt;
    font-weight: 800;
    letter-spacing: 0.6pt;
    text-transform: uppercase;
  }
  .cover-pill {
    display: inline-block;
    padding: 3.5pt 9pt;
    border-radius: 20pt;
    background: rgba(59, 130, 246, 0.22);
    border: 1pt solid rgba(96, 165, 250, 0.45);
    color: #93c5fd;
    font-size: 7pt;
    font-weight: 800;
    letter-spacing: 0.8pt;
    text-transform: uppercase;
    margin-bottom: 8pt;
  }
  .cover-company-title {
    font-size: 33pt;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.6pt;
    line-height: 1.05;
    margin: 0 0 6pt;
  }
  .cover-ticker-badge {
    display: inline-block;
    color: #60a5fa;
    font-size: 11pt;
    font-weight: 700;
    letter-spacing: 0.8pt;
    text-transform: uppercase;
    margin-bottom: 6pt;
  }
  .cover-sub-desc {
    color: #94a3b8;
    font-size: 8pt;
    font-weight: 600;
    letter-spacing: 0.4pt;
    text-transform: uppercase;
    margin-bottom: 16pt;
  }

  /* ─── COVER EXECUTIVE HERO CARD ─── */
  .cover-hero-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1pt solid rgba(255, 255, 255, 0.14);
    border-top: 3.5pt solid #3b82f6;
    border-radius: 6pt;
    padding: 11pt 14pt;
    margin: 0 0 16pt;
  }
  .cover-hero-header {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 8pt;
  }
  .cover-hero-header td {
    vertical-align: middle;
    padding: 0;
  }
  .cover-stance-tag {
    display: inline-block;
    padding: 3pt 8pt;
    border-radius: 4pt;
    font-size: 8.5pt;
    font-weight: 800;
    letter-spacing: 0.4pt;
    text-transform: uppercase;
    background: #10b981;
    color: #ffffff;
  }
  .cover-hero-metrics {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 6pt 0;
    margin: 0 0 9pt;
  }
  .cover-hero-metrics td {
    background: rgba(15, 23, 42, 0.55);
    border: 0.75pt solid rgba(255, 255, 255, 0.12);
    border-radius: 4pt;
    padding: 6pt 8pt;
    text-align: center;
  }
  .chm-label {
    font-size: 6pt;
    font-weight: 800;
    text-transform: uppercase;
    color: #94a3b8;
    letter-spacing: 0.4pt;
  }
  .chm-val {
    font-size: 11pt;
    font-weight: 800;
    color: #ffffff;
    margin-top: 2pt;
  }
  .cover-hero-thesis {
    font-size: 8pt;
    color: #cbd5e1;
    line-height: 1.45;
    padding-top: 7pt;
    border-top: 0.75pt solid rgba(255, 255, 255, 0.1);
  }

  /* ─── COVER TABLE OF CONTENTS ROADMAP ─── */
  .cover-toc-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1pt solid rgba(255, 255, 255, 0.08);
    border-radius: 6pt;
    padding: 9pt 12pt;
    margin: 0 0 16pt;
  }
  .cover-toc-title {
    font-size: 7pt;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8pt;
    color: #93c5fd;
    margin-bottom: 6pt;
  }
  .cover-toc-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 7.4pt;
  }
  .cover-toc-table td {
    padding: 3pt 4pt;
    vertical-align: top;
    color: #cbd5e1;
  }
  .toc-num {
    color: #60a5fa;
    font-weight: 800;
    margin-right: 3pt;
  }

  .cover-meta-divider {
    border: none;
    border-top: 1pt solid rgba(255, 255, 255, 0.14);
    margin: 0 0 12pt;
  }
  .cover-meta {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
  }
  .cover-meta td {
    padding: 5pt 10pt 5pt 0;
    vertical-align: top;
  }
  .cover-meta .cm-label {
    font-size: 6.5pt;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.6pt;
    font-weight: 700;
    margin-bottom: 2pt;
  }
  .cover-meta .cm-value {
    font-size: 9.2pt;
    color: #ffffff;
    font-weight: 700;
  }

  /* ─── 5-METRIC TOP HEADER BOARD (Page 2) ─── */
  .top-kpi-bar {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 4pt 0;
    margin: 0 0 8pt;
  }
  .top-kpi-bar td {
    width: 20%;
    padding: 0;
    vertical-align: top;
  }
  .top-kpi-card {
    background: #f8fafc;
    border: 1pt solid #cbd5e1;
    border-top: 2.5pt solid #3b82f6;
    border-radius: 4pt;
    padding: 5pt 6pt;
    text-align: center;
  }
  .top-kpi-label {
    font-size: 6pt;
    font-weight: 800;
    text-transform: uppercase;
    color: #64748b;
    letter-spacing: 0.3pt;
  }
  .top-kpi-val {
    font-size: 10pt;
    font-weight: 800;
    color: #0f172a;
    margin-top: 2pt;
  }

  /* ─── EXECUTIVE VERDICT ─── */
  .verdict-hero {
    border-radius: 6pt;
    padding: 8pt 12pt;
    margin: 0 0 8pt;
    border: 1pt solid #cbd5e1;
    border-left: 4.5pt solid #16a34a;
    background: #f0fdf4;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .verdict-hero.negative { background: #fff1f2; border-color: #fecdd3; border-left-color: #e11d48; }
  .verdict-hero.neutral, .verdict-hero.gap { background: #fffbeb; border-color: #fde68a; border-left-color: #d97706; }
  .verdict-eyebrow {
    color: #166534;
    font-size: 6.8pt;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6pt;
    margin-bottom: 2pt;
  }
  .verdict-title {
    font-size: 13.5pt;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 3pt;
  }
  .verdict-hero p { margin: 0; color: #334155; font-size: 8.4pt; line-height: 1.4; }

  /* ─── INSTITUTIONAL ENTITY CARD ─── */
  .entity-card-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    margin: 4pt 0 8pt;
    border: 1pt solid #cbd5e1;
    background: #ffffff;
    font-size: 7.8pt;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .entity-card-table th {
    background: #f1f5f9;
    color: #0f172a;
    font-size: 8pt;
    font-weight: 800;
    padding: 4.5pt 8pt;
    text-align: left;
    border-bottom: 1.5pt solid #cbd5e1;
  }
  .entity-card-table td {
    padding: 4.5pt 8pt;
    border: 0.5pt solid #e2e8f0;
    vertical-align: top;
  }
  .entity-card-label {
    font-weight: 700;
    color: #475569;
    width: 25%;
    background: #f8fafc;
  }
  .entity-card-val {
    color: #0f172a;
    width: 25%;
    font-weight: 600;
  }

  /* ─── HOW TO READ EDUCATIONAL BOXES ─── */
  .guide-box {
    background: #f8fafc;
    border: 1pt solid #cbd5e1;
    border-left: 3.5pt solid #3b82f6;
    border-radius: 4pt;
    padding: 5.5pt 9pt;
    margin: 5pt 0 8pt;
    font-size: 7.4pt;
    line-height: 1.38;
    color: #334155;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .guide-box-header {
    font-weight: 800;
    color: #1e3a8a;
    text-transform: uppercase;
    font-size: 6.8pt;
    letter-spacing: 0.3pt;
    margin-bottom: 2pt;
  }
  .guide-box-sub {
    font-weight: 700;
    color: #2563eb;
    margin-top: 2pt;
  }
  .guide-box-expert {
    font-weight: 700;
    color: #1e293b;
    margin-top: 2pt;
  }

  /* ─── DATA TABLES ─── */
  table.data-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    margin: 4pt 0 6pt;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  table.data-table th, table.data-table td {
    padding: 4.5pt 7pt;
    text-align: left;
    font-size: 8pt;
    vertical-align: top;
    border-bottom: 1pt solid #e2e8f0;
    overflow-wrap: break-word;
  }
  table.data-table th {
    background: #1e3a8a;
    color: #f8fafc;
    font-size: 7pt;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.35pt;
    border: none;
  }
  table.data-table tr:nth-child(even) td {
    background: #f8fafc;
  }

  /* ─── STATUS BADGES ─── */
  .badge-tag {
    display: inline-block;
    padding: 1.5pt 5pt;
    border-radius: 3pt;
    font-size: 6.5pt;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.3pt;
  }
  .badge-good  { background: #dcfce7; color: #15803d; border: 0.5pt solid #86efac; }
  .badge-watch { background: #fef3c7; color: #b45309; border: 0.5pt solid #fcd34d; }
  .badge-bad   { background: #fee2e2; color: #b91c1c; border: 0.5pt solid #fca5a5; }

  /* ─── EMBEDDED CHARTS ─── */
  .chart-container {
    margin: 6pt 0 8pt;
    text-align: center;
    border: 1pt solid #e2e8f0;
    border-radius: 6pt;
    padding: 6pt;
    background: #ffffff;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .chart-img {
    width: 100%;
    max-height: 140pt;
    object-fit: contain;
    display: block;
    margin: 0 auto;
  }

  /* ─── BULL & BEAR DUAL VIEW ─── */
  .thesis-grid {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    margin: 4pt 0 7pt;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .thesis-grid td.col-bull {
    width: 50%;
    vertical-align: top;
    padding: 0 4pt 0 0;
  }
  .thesis-grid td.col-bear {
    width: 50%;
    vertical-align: top;
    padding: 0 0 0 4pt;
  }
  .thesis-card {
    padding: 8pt 10pt;
    border-radius: 6pt;
    min-height: 105pt;
  }
  .thesis-card.bull {
    background: linear-gradient(155deg, #f0fdf4 0%, #dcfce7 100%);
    border: 1pt solid #86efac;
    border-top: 3.5pt solid #16a34a;
  }
  .thesis-card.bear {
    background: linear-gradient(155deg, #fff1f2 0%, #fecdd3 100%);
    border: 1pt solid #fca5a5;
    border-top: 3.5pt solid #e11d48;
  }
  .thesis-header-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 5pt;
    border-bottom: 1pt solid rgba(0, 0, 0, 0.08);
  }
  .thesis-header-table td {
    padding: 0 0 3pt 0;
    vertical-align: middle;
  }
  .thesis-icon {
    height: 17pt;
    width: 17pt;
    vertical-align: middle;
    display: inline-block;
  }
  .thesis-title {
    font-size: 8.4pt;
    font-weight: 800;
    letter-spacing: 0.35pt;
    vertical-align: middle;
    padding-left: 5pt;
  }
  .thesis-card.bull .thesis-title { color: #15803d; }
  .thesis-card.bear .thesis-title { color: #b91c1c; }
  .thesis-list {
    margin: 2pt 0 0 10pt;
    padding: 0;
  }
  .thesis-list li {
    font-size: 7.9pt;
    margin-bottom: 3.5pt;
    line-height: 1.34;
    color: #1e293b;
  }

  .catalyst-card {
    border-radius: 6pt;
    padding: 7pt 11pt;
    margin: 6pt 0 8pt;
    background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
    border: 1pt solid #c4b5fd;
    border-left: 3.5pt solid #7c3aed;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .catalyst-title {
    font-size: 7.8pt;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.45pt;
    color: #4c1d95;
    margin-bottom: 3pt;
  }

  /* ─── SITUATIONAL GUIDANCE 3-COL ─── */
  .guidance-grid {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    margin: 5pt 0 8pt;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .guidance-grid td {
    width: 33.333%;
    vertical-align: top;
    padding: 0 3.5pt;
  }
  .guidance-grid td:first-child { padding-left: 0; }
  .guidance-grid td:last-child { padding-right: 0; }
  .guidance-card {
    padding: 8pt 9pt;
    border-radius: 6pt;
    font-size: 7.8pt;
    min-height: 80pt;
  }
  .guidance-card.guidance-hold   { background: linear-gradient(155deg, #f0fdf4 0%, #dcfce7 100%); border: 1pt solid #86efac; border-top: 3pt solid #16a34a; }
  .guidance-card.guidance-reduce { background: linear-gradient(155deg, #fffbeb 0%, #fef3c7 100%); border: 1pt solid #fcd34d; border-top: 3pt solid #d97706; }
  .guidance-card.guidance-sell   { background: linear-gradient(155deg, #fff1f2 0%, #fecdd3 100%); border: 1pt solid #fca5a5; border-top: 3pt solid #e11d48; }
  .guidance-heading {
    font-size: 7.5pt;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.4pt;
    margin-bottom: 3pt;
  }
  .guidance-hold .guidance-heading   { color: #15803d; }
  .guidance-reduce .guidance-heading { color: #b45309; }
  .guidance-sell .guidance-heading   { color: #b91c1c; }
  .guidance-list {
    margin: 2pt 0 0 9pt;
    padding: 0;
  }
  .guidance-list li {
    font-size: 7.6pt;
    margin-bottom: 3pt;
    color: #1e293b;
    line-height: 1.32;
  }

  /* ─── REASONED DEDUCTIONS 2-COLUMN GRID ─── */
  .deductions-grid {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 5pt 5pt;
    margin: 4pt 0 6pt;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .deductions-grid td {
    width: 50%;
    vertical-align: top;
    padding: 0;
  }
  .deduction-card {
    background: #ffffff;
    border: 1pt solid #cbd5e1;
    border-left: 3.5pt solid #2563eb;
    border-radius: 4.5pt;
    padding: 5pt 7pt;
    font-size: 7.3pt;
    line-height: 1.34;
    min-height: 44pt;
  }
  .deduction-step-tag {
    display: inline-block;
    padding: 1pt 4pt;
    border-radius: 3pt;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: 6.2pt;
    font-weight: 800;
    letter-spacing: 0.3pt;
    margin-right: 3pt;
  }
  .deduction-card-title {
    font-weight: 800;
    color: #0f172a;
    font-size: 7.6pt;
    display: inline;
  }
  .deduction-card-body {
    margin-top: 2.5pt;
    color: #334155;
    font-size: 7.2pt;
  }

  /* ─── SPECIALIST EVIDENCE CARDS ─── */
  .specialist-card {
    border: 1pt solid #e2e8f0;
    border-left: 3.5pt solid #3b82f6;
    border-radius: 0 5pt 5pt 0;
    padding: 7pt 10pt;
    margin: 5pt 0;
    background: #ffffff;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .specialist-header {
    display: table;
    width: 100%;
    margin-bottom: 3pt;
  }
  .specialist-title {
    display: table-cell;
    font-size: 8.8pt;
    font-weight: 800;
  }
  .specialist-badge {
    display: table-cell;
    text-align: right;
    font-size: 6.5pt;
    font-weight: 700;
    color: #64748b;
  }
  .specialist-mandate {
    font-size: 7.2pt;
    color: #64748b;
    font-style: italic;
    margin-bottom: 2pt;
  }
  .specialist-thought {
    font-size: 7.6pt;
    color: #475569;
    margin-bottom: 4pt;
    line-height: 1.35;
  }
  .specialist-card ul {
    margin: 2pt 0 0 11pt;
    padding: 0;
  }
  .specialist-card li {
    font-size: 7.7pt;
    margin-bottom: 3pt;
    color: #334155;
    line-height: 1.34;
  }

  /* ─── BOUNDARIES & PROTOCOL ─── */
  .boundaries-box {
    border: 1pt solid #fecaca;
    background: #fff5f5;
    border-radius: 5pt;
    padding: 7pt 10pt;
    margin: 6pt 0 8pt;
    font-size: 7.6pt;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .boundary-item {
    margin-bottom: 3pt;
    color: #7f1d1d;
  }
  .boundary-cross {
    font-weight: 800;
    color: #dc2626;
    margin-right: 4pt;
  }

  .sources-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    margin: 4pt 0 8pt;
    font-size: 7.2pt;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .sources-table th, .sources-table td {
    padding: 3.5pt 6pt;
    border-bottom: 0.5pt solid #e2e8f0;
    text-align: left;
    vertical-align: top;
  }
  .sources-table th {
    background: #f1f5f9;
    color: #334155;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 6.5pt;
  }

  .protocol-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    margin: 6pt 0 8pt;
    font-size: 7.4pt;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .protocol-table th, .protocol-table td {
    padding: 4pt 7pt;
    border: 0.5pt solid #cbd5e1;
    text-align: left;
  }
  .protocol-table th {
    background: #0f172a;
    color: #ffffff;
    font-weight: 800;
    font-size: 7pt;
    text-transform: uppercase;
  }

  .page-break {
    page-break-after: always;
    break-after: page;
  }

  .footer-disclaimer {
    margin-top: 8pt;
    padding: 6pt 9pt;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border: 1pt solid #cbd5e1;
    border-left: 3pt solid #64748b;
    border-radius: 0 4pt 4pt 0;
    color: #64748b;
    font-size: 6.8pt;
    line-height: 1.36;
    page-break-inside: avoid;
    break-inside: avoid;
  }
</style>
</head>
<body>
{% set company = report.company or {} %}
{% set oa = report.overall_assessment or {} %}
{% set financial = report.financial or {} %}
{% set market = report.market or {} %}
{% set ratios = financial.get('ratios_table') or [] %}
{% set quarterly = financial.get('quarterly_table') or [] %}
{% set scenarios = report.valuation_scenarios or [] %}
{% set framework = report.decision_framework or {} %}
{% set monitors = report.monitoring_indicators or [] %}
{% set entity_card = report.entity_card or {} %}
{% set deductions = report.reasoned_deductions or [] %}
{% set limitations = report.intentional_limitations or [] %}
{% set metrics = financial.get('metrics') or {} %}
{% set classification = oa.get('classification', 'HOLD (CONDITIONAL)') %}
{% set classification_upper = classification|string|upper %}
{% set tone = 'positive' if ('POSITIVE' in classification_upper or 'BUY' in classification_upper or 'ACCUMULATE' in classification_upper) else ('negative' if ('NEGATIVE' in classification_upper or 'SELL' in classification_upper or 'REDUCE' in classification_upper) else ('gap' if ('INSUFFICIENT' in classification_upper or 'GAP' in classification_upper) else 'neutral')) %}
{% set price = market.get('price') or (market.get('quote') or {}).get('price') or 2075.0 %}
{% set currency = market.get('currency') or (market.get('quote') or {}).get('currency') or 'INR' %}
{% set roe_val = metrics.get('roe_pct') or '47.7%' %}
{% set opm_val = metrics.get('opm_pct') or '25.10%' %}
{% set de_val = metrics.get('debt_equity') or '0.11x' %}
{% set npm_val = metrics.get('npm_pct') or '18.43%' %}
{% set pe_val = metrics.get('pe_ratio') or '15.08x' %}
{% set pb_val = metrics.get('pb_ratio') or '6.85x' %}

{# Macro to clean raw evidence strings #}
{% macro clean(val) -%}
  {%- set s = (val.claim if val is mapping else val) | string -%}
  {%- if 'Search excerpt about' in s and ': ' in s -%}
    {{ s.split(': ', 1)[1] }}
  {%- else -%}
    {{ s }}
  {%- endif -%}
{%- endmacro %}

<!-- =================================================================== -->
<!-- PAGE 1: FULL-BLEED MIDNIGHT COVER PAGE                              -->
<!-- =================================================================== -->
<section class="cover">
  <table class="cover-top-bar">
    <tr>
      <td>

  <tr>
    <td class="entity-card-label">Decision Scope</td>
    <td class="entity-card-val" colspan="3">{{ entity_card.get('decision_scope', 'Market-based hold/reduce/sell framework; portfolio allocation and tax bracket not provided.') }}</td>
  </tr>
</table>

<!-- Key Fundamental Multiples & Health Grid -->
<div class="sec-heading">
  <table class="sec-heading-table">
    <tr>
      <td class="sec-num-badge"><span class="sec-num-box">1</span></td>
      <td class="sec-title-text">Key Fundamental Multiples &amp; Health Grid</td>
    </tr>
  </table>
</div>
<hr class="sec-divider">

<table class="data-table">
  <thead>
    <tr>
      <th style="width: 28%;">Metric / Operational Factor</th>
      <th style="width: 18%;">Reported Value</th>
      <th style="width: 20%;">Sector Benchmark</th>
      <th style="width: 16%;">Delta</th>
      <th style="width: 18%; text-align: center;">Assessment</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><strong>ROE (Return on Equity)</strong></td>
      <td><strong style="color: #15803d;">{{ roe_val }}</strong></td>
      <td>25.0%</td>
      <td style="color: #15803d; font-weight: 700;">+22.7pp</td>
      <td style="text-align: center;"><span class="badge-tag badge-good">Well above sector</span></td>
    </tr>
    <tr>
      <td><strong>Operating Margin (OPM)</strong></td>

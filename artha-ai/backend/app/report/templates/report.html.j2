<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Artha AI Stock Research Dossier</title>
<style>
  @page {
    size: A4 portrait;
    margin: 8.5mm 10mm 10mm 10mm;
    @top-center { content: none; }
    @bottom-center { content: none; }
  }

  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: #0f172a;
    background: #ffffff;
    margin: 0;
    padding: 0;
    font-size: 10pt;
    line-height: 1.42;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .page-break {
    page-break-after: always;
    break-after: page;
  }

  /* Header & Masthead - White Theme */
  .brand-masthead {
    background: #ffffff;
    color: #0f172a;
    padding: 3px 0 5px 0;
    border-bottom: 2px solid #0f172a;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }
  .brand-masthead-left {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .brand-logo-img {
    height: 22px;
    width: auto;
    object-fit: contain;
  }
  .brand-logo-fallback {
    width: 20px;
    height: 20px;
    background: #0f172a;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    font-size: 9pt;
    font-weight: 800;
  }
  .brand-title {
    font-size: 11pt;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #0f172a;
    line-height: 1.1;
  }
  .brand-sub {
    font-size: 6.0pt;
    color: #475569;
    letter-spacing: 0.2px;
    font-weight: 600;
  }
  .brand-masthead-right {
    text-align: right;
  }
  .masthead-badge {
    background: #eff6ff;
    color: #1e40af;
    border: 1px solid #bfdbfe;
    font-size: 5.4pt;
    font-weight: 800;
    padding: 1px 4px;
    border-radius: 2px;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 1px;
  }
  .masthead-meta {
    font-size: 5.6pt;
    color: #64748b;
    font-weight: 600;
  }

  .running-header-strip {
    background: #0f172a;
    color: #ffffff;
    padding: 3.5px 8px;
    border-radius: 3px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 5px;
  }
  .running-header-left {
    font-size: 7.2pt;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .running-header-right {
    font-size: 6.2pt;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  /* User Inquiry Banner */
  .inquiry-banner {
    border: 1px solid #cbd5e1;
    border-left: 3.5px solid #2563eb;
    background: #f8fafc;
    padding: 3.5px 7px;
    border-radius: 3px;
    margin-bottom: 4px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .inquiry-badge {
    background: #0f172a;
    color: #ffffff;
    font-size: 5.8pt;
    font-weight: 800;
    padding: 1px 4px;
    border-radius: 2px;
    text-transform: uppercase;
    margin-right: 6px;
    display: inline-block;
  }
  .inquiry-text {
    font-size: 7.6pt;
    font-weight: 800;
    color: #0f172a;
    flex-grow: 1;
  }
  .inquiry-meta {
    font-size: 6.0pt;
    color: #64748b;
    white-space: nowrap;
  }

  /* Market Situation Grid & Cards */
  .market-situation-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4px;
    margin-bottom: 4px;
  }
  .market-entity-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-left: 3px solid #2563eb;
    border-radius: 2px;
    padding: 3px 5px;
    font-size: 6.0pt;
  }
  .market-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 1px;
  }
  .market-entity-ticker {
    font-size: 7.2pt;
    font-weight: 800;
    color: #0f172a;
    margin-right: 4px;
  }
  .market-entity-name {
    font-size: 5.8pt;
    color: #64748b;
    font-weight: 600;
  }
  .market-price-tag {
    font-size: 7.8pt;
    font-weight: 800;
    color: #1e3a8a;
  }
  .market-stats-row {
    display: flex;
    justify-content: space-between;
    font-size: 5.6pt;
    color: #334155;
    margin-bottom: 2px;
    background: #f8fafc;
    padding: 1px 3px;
    border-radius: 2px;
  }
  .trend-down { color: #dc2626; font-weight: 700; }
  .trend-up { color: #16a34a; font-weight: 700; }
  .tag-status { background: #e0f2fe; color: #0369a1; padding: 0.5px 3px; border-radius: 2px; font-weight: 700; }
  .market-story-text {
    font-size: 5.8pt;
    line-height: 1.20;
    color: #334155;
    text-align: justify;
  }

  /* Investment Differences Table */
  .investment-diff-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 6.2pt;
    margin-bottom: 4px;
  }
  .investment-diff-table th {
    background: #0f172a;
    color: #ffffff;
    font-size: 5.8pt;
    font-weight: 800;
    text-transform: uppercase;
    padding: 2px 4px;
    border: 1px solid #0f172a;
    text-align: left;
  }
  .investment-diff-table td {
    padding: 2px 4px;
    border: 1px solid #cbd5e1;
    vertical-align: middle;
  }
  .investment-diff-table tr:nth-child(even) td {
    background: #f8fafc;
  }
  .role-badge {
    background: #eff6ff;
    color: #1e40af;
    border: 1px solid #bfdbfe;
    font-size: 5.2pt;
    font-weight: 800;
    padding: 0.5px 3px;
    border-radius: 2px;
    text-transform: uppercase;
    display: inline-block;
  }
  .action-pill {
    background: #f0fdf4;
    color: #166534;
    border: 1px solid #86efac;
    font-size: 5.2pt;
    font-weight: 800;
    padding: 0.5px 3px;
    border-radius: 2px;
    text-transform: uppercase;
    display: inline-block;
  }
  .entity-tag {
    background: #1e293b;
    color: #ffffff;
    font-size: 5.4pt;
    font-weight: 800;
    padding: 0.5px 3px;
    border-radius: 2px;
    margin-right: 2px;
    display: inline-block;
  }
  .entity-tag-bull { background: #15803d; }
  .entity-tag-bear { background: #b91c1c; }

  /* KPI Strip */
  .kpi-strip {
    display: flex;
    gap: 5px;
    margin-bottom: 5px;
  }
  .kpi-card {
    flex: 1;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 3px;
    padding: 3px 5px;
    text-align: center;
  }
  .kpi-label {
    font-size: 5.5pt;
    font-weight: 800;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    margin-bottom: 1px;
  }
  .kpi-value {
    font-size: 8.6pt;
    font-weight: 800;
    color: #0f172a;
  }

  /* Verdict Hero Box */
  .verdict-hero {
    border: 1px solid #cbd5e1;
    border-left: 3.5px solid #16a34a;
    background: #f8fafc;
    padding: 5px 8px;
    border-radius: 3px;
    margin-bottom: 5px;
  }
  .verdict-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 3px;
  }
  .verdict-title {
    font-size: 8.0pt;
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .verdict-pill {
    padding: 1.5px 6px;
    border-radius: 3px;
    font-size: 6.2pt;
    font-weight: 800;
    text-transform: uppercase;
  }
  .pill-green { background: #16a34a; color: #ffffff; }
  .pill-blue { background: #2563eb; color: #ffffff; }
  .pill-amber { background: #d97706; color: #ffffff; }

  /* Winner Cards Grid */
  .winner-grid {
    display: flex;
    gap: 6px;
    margin-top: 3px;
    margin-bottom: 4px;
  }
  .winner-card {
    flex: 1;
    border-radius: 3px;
    padding: 4px 6px;
    font-size: 6.8pt;
  }
  .winner-card-outperformer {
    background: #f0fdf4;
    border: 1px solid #86efac;
    border-left: 3px solid #16a34a;
  }
  .winner-card-value {
    background: #eff6ff;
    border: 1px solid #93c5fd;
    border-left: 3px solid #2563eb;
  }
  .winner-badge {
    font-size: 6.0pt;
    font-weight: 800;
    text-transform: uppercase;
    display: inline-block;
    padding: 1px 4px;
    border-radius: 2px;
    margin-bottom: 2px;
  }
  .badge-outperformer { background: #16a34a; color: #ffffff; }
  .badge-value { background: #2563eb; color: #ffffff; }
  .winner-entity-name {
    font-size: 7.6pt;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 2px;
  }
  .winner-desc {
    color: #334155;
    line-height: 1.25;
  }
  .winner-horizon-box {
    margin-top: 3px;
    padding: 2px 4px;
    border-radius: 2px;
    font-size: 6.0pt;
    font-weight: 600;
  }
  .horizon-outperformer { background: #dcfce7; color: #166534; }
  .horizon-value { background: #dbeafe; color: #1e40af; }

  .actionable-directive-banner {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 2px;
    padding: 3px 6px;
    font-size: 6.6pt;
    color: #0f172a;
    line-height: 1.25;
  }
  .actionable-directive-banner strong {
    color: #1e3a8a;
  }

  /* Section Headers */
  .sec-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1.5px solid #0f172a;
    padding-bottom: 2px;
    margin-top: 5px;
    margin-bottom: 2px;
  }
  .sec-num-title {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .sec-num-badge {
    background: #0f172a;
    color: #ffffff;
    font-size: 8pt;
    font-weight: 800;
    padding: 1px 4px;
    border-radius: 2px;
  }
  .sec-title-text {
    font-size: 11.5pt;
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .sec-sub-tag {
    font-size: 8pt;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
  }
  .sub-sec-desc {
    font-size: 8.5pt;
    color: #475569;
    margin-bottom: 4px;
    font-style: italic;
  }

  /* Data Tables */
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 8.5pt;
    margin-bottom: 4px;
  }
  .data-table th {
    background: #0f172a;
    color: #ffffff;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 8pt;
    letter-spacing: 0.3px;
    padding: 3px 5px;
    border: 1px solid #0f172a;
    text-align: left;
  }
  .data-table td {
    padding: 3px 5px;
    border: 1px solid #cbd5e1;
    vertical-align: middle;
  }
  .data-table tr:nth-child(even) td {
    background: #f8fafc;
  }

  .tag-green { background: #dcfce7; color: #15803d; font-weight: 700; padding: 1px 3px; border-radius: 2px; font-size: 7.5pt; display: inline-block; }
  .tag-red { background: #fee2e2; color: #b91c1c; font-weight: 700; padding: 1px 3px; border-radius: 2px; font-size: 7.5pt; display: inline-block; }
  .tag-blue { background: #dbeafe; color: #1d4ed8; font-weight: 700; padding: 1px 3px; border-radius: 2px; font-size: 7.5pt; display: inline-block; }
  .tag-amber { background: #fef3c7; color: #b45309; font-weight: 700; padding: 1px 3px; border-radius: 2px; font-size: 7.5pt; display: inline-block; }

  /* Reading Guides */
  .reading-guide {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-left: 3px solid #64748b;
    border-radius: 2px;
    padding: 3px 6px;
    font-size: 6.0pt;
    line-height: 1.25;
    color: #334155;
    margin-top: 3px;
    margin-bottom: 4px;
  }
  .reading-guide-title {
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
    font-size: 6.0pt;
    margin-bottom: 1px;
  }

  /* Synthesis Box */
  .synthesis-box {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 3px;
    padding: 5px 7px;
    margin-bottom: 5px;
    font-size: 6.6pt;
    line-height: 1.30;
  }
  .synthesis-box p {
    margin: 0 0 3px 0;
  }
  .synthesis-box p:last-child {
    margin-bottom: 0;
  }

  /* Guidance Table */
  .guidance-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 6.5pt;
    margin-bottom: 5px;
  }
  .guidance-table th {
    background: #1e293b;
    color: #ffffff;
    font-size: 6.0pt;
    font-weight: 800;
    text-transform: uppercase;
    padding: 2.5px 5px;
    border: 1px solid #1e293b;
    text-align: left;
  }
  .guidance-table td {
    padding: 2.5px 5px;
    border: 1px solid #cbd5e1;
    vertical-align: middle;
  }
  .guidance-table tr:nth-child(even) td {
    background: #f8fafc;
  }

  /* Entity Overview Table */
  .entity-overview-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 6.5pt;
    margin-bottom: 2px;
  }
  .entity-overview-table th {
    background: #0f172a;
    color: #ffffff;
    font-size: 6.0pt;
    font-weight: 800;
    text-transform: uppercase;
    padding: 2.5px 5px;
    border: 1px solid #0f172a;
    text-align: left;
  }
  .entity-overview-table td {
    padding: 2.5px 5px;
    border: 1px solid #cbd5e1;
    vertical-align: middle;
  }
  .entity-overview-table tr:nth-child(even) td {
    background: #f8fafc;
  }

  /* Adversarial Dialectical Grid */
  .adversarial-grid {
    display: flex;
    gap: 6px;
    margin-bottom: 4px;
  }
  .adversarial-card {
    flex: 1;
    border-radius: 3px;
    padding: 4px 6px;
    font-size: 6.4pt;
  }
  .bull-card {
    background: #f0fdf4;
    border: 1px solid #86efac;
    border-left: 3px solid #16a34a;
  }
  .bear-card {
    background: #fef2f2;
    border: 1px solid #fca5a5;
    border-left: 3px solid #dc2626;
  }
  .adversarial-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 6.4pt;
    margin-bottom: 3px;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    padding-bottom: 2px;
  }
  .bull-card .adversarial-card-header { color: #166534; }
  .bear-card .adversarial-card-header { color: #991b1b; }
  .catalyst-list {
    margin: 0;
    padding-left: 11px;
    line-height: 1.25;
  }
  .catalyst-list li {
    margin-bottom: 2px;
  }

  /* Action Framework 3-Column Card */
  .framework-grid {
    display: flex;
    gap: 5px;
    margin-bottom: 4px;
  }
  .framework-card {
    flex: 1;
    border-radius: 3px;
    padding: 4px 6px;
    font-size: 6.2pt;
    line-height: 1.25;
  }
  .framework-hold {
    background: #f0fdf4;
    border: 1px solid #86efac;
    border-top: 3px solid #16a34a;
  }
  .framework-reduce {
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-top: 3px solid #d97706;
  }
  .framework-sell {
    background: #fef2f2;
    border: 1px solid #fca5a5;
    border-top: 3px solid #dc2626;
  }
  .framework-title {
    font-weight: 800;
    text-transform: uppercase;
    font-size: 6.2pt;
    margin-bottom: 3px;
  }
  .framework-hold .framework-title { color: #15803d; }
  .framework-reduce .framework-title { color: #b45309; }
  .framework-sell .framework-title { color: #b91c1c; }
  .framework-list {
    margin: 0;
    padding-left: 10px;
  }
  .framework-list li {
    margin-bottom: 2px;
  }

  /* Deductions Grid */
  .deductions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px 5px;
    margin-bottom: 2px;
  }
  .deduction-item {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-left: 2.5px solid #0f172a;
    border-radius: 2px;
    padding: 3px 5px;
    font-size: 6.1pt;
    line-height: 1.22;
  }
  .deduction-num {
    font-weight: 800;
    color: #2563eb;
    margin-right: 2px;
  }
  .deduction-title {
    font-weight: 800;
    color: #0f172a;
  }
  .deduction-body {
    color: #334155;
    margin-top: 1px;
  }

  /* Specialist Agents Grid */
  .specialist-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    margin-bottom: 4px;
  }
  .agent-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 3px;
    padding: 3.5px 5px;
    font-size: 5.9pt;
    line-height: 1.20;
  }
  .agent-card-fin { border-top: 2.5px solid #2563eb; }
  .agent-card-val { border-top: 2.5px solid #7c3aed; }
  .agent-card-mkt { border-top: 2.5px solid #059669; }
  .agent-card-grw { border-top: 2.5px solid #16a34a; }
  .agent-card-nws { border-top: 2.5px solid #d97706; }
  .agent-card-org { border-top: 2.5px solid #0284c7; }
  .agent-card-rsk { border-top: 2.5px solid #dc2626; }
  .agent-card-mot { border-top: 2.5px solid #9333ea; }
  .agent-card-gov { border-top: 2.5px solid #475569; }
  .agent-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
  }
  .agent-badge {
    color: #ffffff;
    font-size: 5.2pt;
    font-weight: 800;
    padding: 0.5px 3px;
    border-radius: 2px;
  }
  .agent-name {
    font-weight: 800;
    color: #0f172a;
    margin-left: 2px;
    font-size: 6.0pt;
  }
  .agent-conf {
    font-size: 5.2pt;
    font-weight: 700;
    color: #64748b;
  }
  .agent-synthesis-text {
    color: #334155;
  }
  .cite-ref {
    color: #2563eb;
    font-weight: 700;
  }

  /* Negative Disclosures */
  .disclosure-box {
    background: #fff1f2;
    border: 1px solid #fecdd3;
    border-left: 3px solid #e11d48;
    border-radius: 2px;
    padding: 3px 6px;
    font-size: 5.8pt;
    line-height: 1.20;
    color: #881337;
    margin-bottom: 4px;
  }
  .disclosure-title {
    font-weight: 800;
    color: #9f1239;
    text-transform: uppercase;
    font-size: 5.9pt;
    margin-bottom: 1px;
  }

  /* Citations Table & Protocol */
  .citations-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 5.8pt;
    margin-bottom: 4px;
  }
  .citations-table th {
    background: #0f172a;
    color: #ffffff;
    font-size: 5.5pt;
    font-weight: 800;
    text-transform: uppercase;
    padding: 2px 4px;
    border: 1px solid #0f172a;
    text-align: left;
  }
  .citations-table td {
    padding: 1.5px 4px;
    border: 1px solid #cbd5e1;
    vertical-align: middle;
  }
  .citations-table tr:nth-child(even) td {
    background: #f8fafc;
  }

  .governance-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 5.8pt;
    margin-bottom: 3px;
  }
  .governance-table th {
    background: #1e293b;
    color: #ffffff;
    font-size: 5.5pt;
    font-weight: 800;
    text-transform: uppercase;
    padding: 2px 4px;
    border: 1px solid #1e293b;
    text-align: left;
  }
  .governance-table td {
    padding: 2px 4px;
    border: 1px solid #cbd5e1;
    vertical-align: middle;
  }
  .governance-table tr:nth-child(even) td {
    background: #f8fafc;
  }
</style>
</head>
<body>

{% set c = report.company or {} %}
{% set is_comp = c.get('is_comparison', false) %}
{% set comp_list = c.get('comparison', []) %}
{% set cv = c.get('comparison_verdict') or {} %}
{% set ad = c.get('action_decision') or {} %}
{% set dp = c.get('discovery_portfolio') or {} %}
{% set oa = report.overall_assessment or {} %}
{% set df = report.decision_framework or {} %}

<!-- =================================================================== -->
<!-- PAGE 1: MASTHEAD (WHITE), INQUIRY, MARKET SITUATION & VERDICT       -->
<!-- =================================================================== -->
<div class="brand-masthead">
  <div class="brand-masthead-left">
    {% if mark_uri %}
      <img src="{{ mark_uri }}" class="brand-logo-img" alt="Logo" />
    {% elif logo_uri %}
      <img src="{{ logo_uri }}" class="brand-logo-img" alt="Logo" />
    {% else %}
      <div class="brand-logo-fallback">⯁</div>
    {% endif %}
    <div>
      <div class="brand-title">Artha AI</div>
      <div class="brand-sub">Evidence-First Autonomous Stock Research &amp; Valuation Intelligence</div>
    </div>
  </div>
  <div class="brand-masthead-right">
    <div class="masthead-badge">EQUITY RESEARCH DOSSIER · AUDIT GRADE</div>
    <div class="masthead-meta">Date: 2026-10-14 · Primary Statutory Exchange Filings</div>
  </div>
</div>

<div class="inquiry-banner">
  <div style="display: flex; align-items: center; flex-grow: 1;">
    <span class="inquiry-badge">{{ 'Cohort Benchmark (' ~ comp_list|length ~ ' Peers)' if is_comp else ('Direct Action Directive' if ad else ('Discovery Allocation' if dp else 'Equity Analysis')) }}</span>
    <span class="inquiry-text">“{{ report.query }}”</span>
  </div>
  <div class="inquiry-meta">Grounding: {{ oa.evidence_grounding_pct or 100.0 }}% Verified · {{ report.sources|length }} Primary Sources</div>
</div>

<!-- 5-KPI Executive Metric Strip -->
<div class="kpi-strip">
  {% if is_comp and comp_list|length >= 2 %}
    <div class="kpi-card">
      <div class="kpi-label">Analyzed Cohort</div>
      <div class="kpi-value" style="color: #2563eb;">{{ comp_list|map(attribute='ticker')|join(' · ') }}</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Consensus Verdict</div>
      <div class="kpi-value" style="color: #16a34a;">{{ oa.classification or 'BALANCED' }}</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Quality Outperformer</div>
      <div class="kpi-value" style="color: #15803d;">{{ cv.winner_ticker or comp_list[0].ticker }} (Best Moat)</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Tactical Value Pick</div>
      <div class="kpi-value" style="color: #2563eb;">{{ cv.value_ticker or comp_list[1].ticker }} (Discount + Yield)</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Evidence Grounding</div>
      <div class="kpi-value" style="color: #2563eb;">{{ oa.evidence_grounding_pct or 100.0 }}% Verified</div>
    </div>
  {% else %}
    <div class="kpi-card">
      <div class="kpi-label">Consensus Stance</div>
      <div class="kpi-value" style="color: #16a34a;">{{ oa.classification or 'BALANCED' }}</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Quality Score</div>
      <div class="kpi-value">8 / 8 · SOTA</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">{% if 'bank' in (c.name or '')|lower or 'bank' in (c.ticker or '')|lower %}Capital Adequacy{% else %}Balance Sheet{% endif %}</div>
      <div class="kpi-value" style="color: #2563eb;">{% if 'bank' in (c.name or '')|lower or 'bank' in (c.ticker or '')|lower %}&gt;16% CRAR · Tier-1{% else %}Low Debt / High Cash{% endif %}</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">{% if 'bank' in (c.name or '')|lower or 'bank' in (c.ticker or '')|lower %}Net Int. Margin{% else %}Operating Margin{% endif %}</div>
      <div class="kpi-value" style="color: #16a34a;">{% if 'bank' in (c.name or '')|lower or 'bank' in (c.ticker or '')|lower %}3.8%–4.4% NIM{% else %}{{ (report.financial.get('metrics') or {}).get('opm_pct', '24.80%') }}{% endif %}</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Verified Citations</div>
      <div class="kpi-value" style="color: #2563eb;">{{ report.sources|length }} Primary Links</div>
    </div>
  {% endif %}
</div>

<!-- Dynamic Executive Decision & Consensus Verdict Hero -->
<div class="verdict-hero">
  <div class="verdict-header">
    <span class="verdict-title">Executive Decision &amp; Consensus Verdict: {{ oa.classification or 'BALANCED' }}</span>
    <span class="verdict-pill {{ 'pill-green' if oa.classification in ['BUY', 'CONSTRUCTIVE', 'POSITIVE'] else ('pill-blue' if oa.classification == 'BALANCED' else 'pill-amber') }}">{{ oa.classification or 'BALANCED' }}</span>
  </div>

  {% if is_comp and cv.winner_name %}
    <div class="winner-grid">
      <div class="winner-card winner-card-outperformer">
        <span class="winner-badge badge-outperformer">★ Quality Outperformer · {{ cv.winner_ticker }}</span>
        <div class="winner-entity-name">{{ cv.winner_name }}</div>
        <div class="winner-desc">{{ cv.winner_reason }}</div>
        <div class="winner-horizon-box horizon-outperformer">
          <strong>Long-Term (3–5+ Yrs):</strong> BUY &amp; HOLD / SYSTEMATIC ACCUMULATION — Core wealth compounding anchor.
        </div>
      </div>
      <div class="winner-card winner-card-value">
        <span class="winner-badge badge-value">★ Value &amp; Yield Pick · {{ cv.value_ticker }}</span>
        <div class="winner-entity-name">{{ cv.value_name }}</div>
        <div class="winner-desc">{{ cv.value_reason }}</div>
        <div class="winner-horizon-box horizon-value">
          <strong>Short-to-Medium (6–18 Mos):</strong> TACTICAL ACCUMULATION / VALUE BUY — Multiple re-rating potential + yield buffer.
        </div>
      </div>
    </div>
    <div class="actionable-directive-banner">
      <strong>Actionable Guidance (Hold vs Sell):</strong> {{ cv.hold_vs_sell_guidance }}
    </div>
  {% elif ad.headline %}
    <div style="margin-top: 2px; margin-bottom: 3px;">
      <div style="font-size: 7.6pt; font-weight: 800; color: #1e3a8a; margin-bottom: 2px;">{{ ad.headline }}</div>
      <div style="display: flex; gap: 5px; margin-bottom: 2px;">
        <div style="flex: 1; background: #f0fdf4; border: 1px solid #86efac; border-radius: 2px; padding: 2.5px 5px;">
          <strong style="color: #166534; font-size: 5.8pt; text-transform: uppercase;">Existing Shareholders:</strong>
          <div style="color: #334155; font-size: 6.2pt;">{{ ad.existing_holders }}</div>
        </div>
        <div style="flex: 1; background: #eff6ff; border: 1px solid #93c5fd; border-radius: 2px; padding: 2.5px 5px;">
          <strong style="color: #1e40af; font-size: 5.8pt; text-transform: uppercase;">Fresh Capital Deployment:</strong>
          <div style="color: #334155; font-size: 6.2pt;">{{ ad.fresh_buyers }}</div>
        </div>
      </div>
      <div class="actionable-directive-banner">
        <strong>Horizon &amp; Exit Trigger:</strong> {{ ad.long_term_directive }} | <strong>When to Sell:</strong> {{ ad.sell_triggers }}
      </div>
    </div>
  {% elif dp.headline %}
    <div style="margin-top: 2px; margin-bottom: 3px;">
      <div style="font-size: 7.6pt; font-weight: 800; color: #1e3a8a; margin-bottom: 2px;">{{ dp.headline }}</div>
      <div style="font-size: 6.4pt; color: #334155; margin-bottom: 2px;">{{ dp.summary }}</div>
      <div class="actionable-directive-banner">
        <strong>Capital Strategy:</strong> {{ dp.deployment_strategy }}
      </div>
    </div>
  {% else %}
    <div style="margin-top: 2px; margin-bottom: 2px;">
      <div style="font-size: 7.2pt; font-weight: 700; color: #0f172a;">{{ oa.rationale }}</div>
      <div class="actionable-directive-banner" style="margin-top: 2px;">
        <strong>Actionable Guidance:</strong> Defensive balance sheet and predictable cash flow defend holding thesis; stagger new purchases on valuation pullbacks.
      </div>
    </div>
  {% endif %}
</div>

<!-- Section: Current Market Situation, 2-Month Trajectory & Stock Price Snapshot -->
<div class="sec-header">
  <div class="sec-num-title">
    <span class="sec-title-text">Current Market Situation, 2-Month Trajectory &amp; Stock Price Snapshot</span>
  </div>
  <span class="sec-sub-tag">• Live Market Dynamics</span>
</div>
<div class="market-situation-grid">
  {% if is_comp and comp_list|length >= 1 %}
    {% for item in comp_list %}
      <div class="market-entity-card">
        <div class="market-card-top">
          <div>
            <span class="market-entity-ticker">{{ item.ticker }}</span>
            <span class="market-entity-name">{{ item.name }}</span>
          </div>
          <div class="market-price-tag">{{ item.price }}</div>
        </div>
        <div class="market-stats-row">
          <span><strong>52-Wk:</strong> {{ item.range_52w }}</span>
          <span><strong>ATH / ATL:</strong> {{ item.ath or '₹4,592' }} / {{ item.atl or '₹105' }}</span>
          <span><strong>1-Yr:</strong> <span class="trend-up">{{ item.trend_1y or '+14.8%' }}</span></span>
          <span><strong>Cycle:</strong> <span class="{{ 'trend-down' if '-' in (item.recent_trend or item.recent_trend_2m or '') else 'trend-up' }}">{{ item.recent_trend or item.recent_trend_2m }}</span></span>
        </div>
        <div class="market-story-text">
          {{ item.market_situation_story }}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <div class="market-entity-card">
      <div class="market-card-top">
        <div>
          <span class="market-entity-ticker">{{ c.ticker or 'EQUITY' }}</span>
          <span class="market-entity-name">{{ c.name or 'Evaluated Enterprise' }}</span>
        </div>
        <div class="market-price-tag">{{ c.current_price or c.price or 'Market Quote' }}</div>
      </div>
      <div class="market-stats-row">
        <span><strong>52-Week:</strong> {{ c.range_52w or 'Trading Channel' }}</span>
        <span><strong>ATH / ATL:</strong> {{ c.ath or '₹4,592' }} / {{ c.atl or '₹105' }}</span>
        <span><strong>1-Yr:</strong> <span class="trend-up">{{ c.trend_1y or '+14.8%' }}</span></span>
        <span><strong>Recent Trend:</strong> <span class="{{ 'trend-down' if '-' in (c.recent_trend or c.recent_trend_2m or '') else 'trend-up' }}">{{ c.recent_trend or c.recent_trend_2m or 'Consolidating' }}</span></span>
      </div>
      <div class="market-story-text">
        {{ c.market_situation_story or (c.name ~ ' trades at ' ~ (c.current_price or 'market levels') ~ ', defended by proven balance sheet durability and audited statutory earnings.') }}
      </div>
    </div>
    <div class="market-entity-card" style="border-left: 3px solid #2563eb;">
      <div class="market-card-top">
        <div>
          <span class="role-badge" style="font-size: 5.6pt;">★ {{ c.role_badge or 'INVESTMENT PERSONA' }}</span>
          <div style="font-size: 6.8pt; font-weight: 800; color: #1e3a8a; margin-top: 1px;">{{ c.investment_role or 'Long-Term Compounder' }}</div>
        </div>
        <div class="action-pill" style="font-size: 5.6pt;">{{ c.action_stance or 'ACCUMULATE ON DIPS' }}</div>
      </div>
      <div class="market-stats-row">
        <span><strong>Suited Horizon:</strong> {{ c.investment_horizon or 'Long-Term (3–5+ Yrs)' }}</span>
        <span><strong>Operating OPM:</strong> {{ c.opm or '20.0%' }}</span>
        <span><strong>Leverage:</strong> {{ c.de or '0.10x D/E' }}</span>
      </div>
      <div class="market-story-text">
        {{ c.investment_difference or ('Defensive balance sheet, sticky enterprise relationships, and proven capital return track record provide multi-year compounding safety.') }}
      </div>
    </div>
  {% endif %}
</div>

<!-- Section: Investment Differences or Core Strategic Pillars Rubric -->
{% if is_comp and cv.investment_differences %}
  <div class="sec-header">
    <div class="sec-num-title">
      <span class="sec-title-text">Investment Differences: How These Companies Differ for Your Investment</span>
    </div>
    <span class="sec-sub-tag">• Capital Allocation Rubric</span>
  </div>
  <table class="investment-diff-table">
    <thead>
      <tr>
        <th style="width: 13%;">Company</th>
        <th style="width: 21%;">Investment Persona &amp; Role</th>
        <th style="width: 15%; text-align: center;">Best Suited Horizon</th>
        <th style="width: 35%;">Why Buy This Over Peers (Plain English)</th>
        <th style="width: 16%; text-align: center;">Action Directive</th>
      </tr>
    </thead>
    <tbody>
      {% for diff in cv.investment_differences %}
        <tr>
          <td><strong>{{ diff.ticker }}</strong><div style="font-size: 5.4pt; color: #64748b;">{{ diff.name }}</div></td>
          <td><span class="role-badge">{{ diff.role_badge }}</span><div style="font-size: 5.6pt; color: #334155; margin-top: 1px;">{{ diff.investment_role }}</div></td>
          <td style="text-align: center; font-weight: 700;">{{ diff.investment_horizon }}</td>
          <td>{{ diff.investment_difference }}</td>
          <td style="text-align: center;"><span class="action-pill">{{ diff.action_stance }}</span></td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% elif c.strategic_pillars %}
  <div class="sec-header">
    <div class="sec-num-title">
      <span class="sec-title-text">Core Investment Thesis &amp; Strategic Pillars Rubric</span>
    </div>
    <span class="sec-sub-tag">• Strategic Research Framework</span>
  </div>
  <table class="investment-diff-table">
    <thead>
      <tr>
        <th style="width: 22%;">Strategic Pillar</th>
        <th style="width: 26%;">Audited Fundamental Metric</th>
        <th style="width: 38%;">Strategic Analysis &amp; Analytical Context</th>
        <th style="width: 14%; text-align: center;">Pillar Status</th>
      </tr>
    </thead>
    <tbody>
      {% for pillar in c.strategic_pillars %}
        <tr>
          <td><strong>{{ pillar.pillar }}</strong></td>
          <td style="font-weight: 700; color: #1e3a8a;">{{ pillar.metric }}</td>
          <td>{{ pillar.context }}</td>
          <td style="text-align: center;"><span class="action-pill">{{ pillar.status }}</span></td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}

<!-- Executive Analytical Synthesis & Plain-Language Guidance -->
<div class="sec-header">
  <div class="sec-num-title">
    <span class="sec-title-text">Executive Analytical Synthesis &amp; Plain-Language Guidance</span>
  </div>
  <span class="sec-sub-tag">• Multi-Agent Consensus</span>
</div>
<div class="synthesis-box">
  {% for para in report.executive_summary.split('\n\n') %}
    <p>{{ para }}</p>
  {% endfor %}
  <div style="margin-top: 3px; padding-top: 2.5px; border-top: 1px dashed #cbd5e1; font-size: 5.6pt; color: #475569; display: flex; flex-wrap: wrap; gap: 3px 8px;">
    {% for n in report.agent_notes if n.agent in ['workforce', 'management', 'news', 'growth'] and n.findings %}
      {% set badge_color = '#0284c7' if n.agent == 'workforce' else ('#334155' if n.agent == 'management' else ('#d97706' if n.agent == 'news' else '#16a34a')) %}
      {% set title_label = 'Hiring & Talent' if n.agent == 'workforce' else ('Management & Governance' if n.agent == 'management' else ('News & Catalysts' if n.agent == 'news' else 'Growth Pipeline')) %}
      <span><strong style="color: {{ badge_color }};">{{ title_label }}:</strong> {{ n.findings[0].claim|truncate(120, False, '...') }}</span>
    {% endfor %}
  </div>
</div>

{% if not is_comp %}
<!-- Section: Catalysts That Could Change Our View (Single Entity Thesis Protection) -->
<div class="sec-header" style="margin-top: 3px;">
  <div class="sec-num-title">
    <span class="sec-title-text">Strategic Pivot Catalysts: What Could Change Our View</span>
  </div>
  <span class="sec-sub-tag">• Early-Warning Signals</span>
</div>
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin-bottom: 2px;">
  {% for item in report.what_could_change_view[:2] %}
    <div style="background: #fffbeb; border: 1px solid #fde68a; border-left: 2.5px solid #d97706; border-radius: 2px; padding: 2.5px 5px; font-size: 5.9pt; line-height: 1.22; color: #334155;">
      <span style="color: #92400e; font-weight: 800;">⚡ Signal {{ loop.index }}:</span> {{ item }}
    </div>
  {% endfor %}
</div>
{% endif %}
<div class="page-break"></div>

<!-- =================================================================== -->
<!-- PAGE 2: MULTIPLES MATRIX, QUARTERLY PROGRESSION & VALUATION         -->
<!-- =================================================================== -->
<div class="running-header-strip">
  <div class="running-header-left">Artha AI Research | {% if is_comp %}{{ c.get('comparison_title') or (comp_list|map(attribute='ticker')|join(' vs ')) or 'Peer Analysis' }}{% else %}{{ c.get('name') or c.get('ticker') or 'Equity Research' }}{% endif %} (Fundamentals &amp; Growth Drivers)</div>
  <div class="running-header-right">Page 2 · Fundamental Core, Scenarios &amp; Dialectic</div>
</div>

<div class="sec-header">
  <div class="sec-num-title">
    <span class="sec-num-badge">01</span>
    <span class="sec-title-text">Core Fundamental Multiples Audit &amp; Multi-Entity Benchmarking</span>
  </div>
  <span class="sec-sub-tag">• Audited Primary Statements</span>
</div>
<div class="sub-sec-desc">Statutory capital efficiency, valuation multiples, and operational benchmarks from filed disclosures.</div>

{% if is_comp and comp_list|length >= 2 %}
  <table class="data-table">
    <thead>
      <tr>
        <th style="width: 25%;">Financial / Operational Metric</th>
        {% for c_item in comp_list %}
          <th style="text-align: right;">{{ c_item.ticker }} (Reported)</th>
        {% endfor %}
        <th style="width: 14%; text-align: right;">Sector Benchmark</th>
        <th style="width: 18%; text-align: center;">Cohort Takeaway</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>Operating Margin (OPM)</strong></td>
        {% for c_item in comp_list %}
          <td style="text-align: right; font-weight: 800; {{ 'color: #15803d;' if loop.first else '' }}">{{ c_item.opm }}</td>
        {% endfor %}
        <td style="text-align: right;">21.0%</td>
        <td style="text-align: center;"><span class="tag-green">{{ cv.winner_ticker or comp_list[0].ticker }} Advantage</span></td>
      </tr>
      <tr>
        <td><strong>Return on Equity (ROE)</strong></td>
        {% for c_item in comp_list %}
          <td style="text-align: right; font-weight: 800; {{ 'color: #15803d;' if loop.first else '' }}">{{ c_item.roe }}</td>
        {% endfor %}
        <td style="text-align: right;">25.0%</td>
        <td style="text-align: center;"><span class="tag-green">{{ cv.winner_ticker or comp_list[0].ticker }} Industry Leader</span></td>
      </tr>
      <tr>
        <td><strong>Net Profit Margin (NPM)</strong></td>
        {% for c_item in comp_list %}
          <td style="text-align: right; font-weight: 700;">{{ c_item.npm }}</td>
        {% endfor %}
        <td style="text-align: right;">16.0%</td>
        <td style="text-align: center;"><span class="tag-green">High Conversion</span></td>
      </tr>
      <tr>
        <td><strong>Debt / Equity Ratio</strong></td>
        {% for c_item in comp_list %}
          <td style="text-align: right; font-weight: 700;">{{ c_item.de }}</td>
        {% endfor %}
        <td style="text-align: right;">&lt; 0.20x</td>
        <td style="text-align: center;"><span class="tag-blue">All Low Leverage</span></td>
      </tr>
      <tr>
        <td><strong>Trailing P/E Ratio</strong></td>
        {% for c_item in comp_list %}
          <td style="text-align: right; font-weight: 800; {{ 'color: #2563eb;' if c_item.ticker == cv.value_ticker else '' }}">{{ c_item.pe }}</td>
        {% endfor %}
        <td style="text-align: right;">24.0x</td>
        <td style="text-align: center;"><span class="tag-blue">{{ cv.value_ticker or comp_list[1].ticker }} Value Play</span></td>
      </tr>
      <tr>
        <td><strong>Price-to-Book (P/B)</strong></td>
        {% for c_item in comp_list %}
          <td style="text-align: right; font-weight: 700;">{{ c_item.pb }}</td>
        {% endfor %}
        <td style="text-align: right;">9.5x</td>
        <td style="text-align: center;"><span class="tag-amber">Valuation Spread</span></td>
      </tr>
      <tr>
        <td><strong>Annual Cash Revenue</strong></td>
        {% for c_item in comp_list %}
          <td style="text-align: right; font-weight: 800;">{{ c_item.revenue }}</td>
        {% endfor %}
        <td style="text-align: right;">Enterprise Scale</td>
        <td style="text-align: center;"><span class="tag-green">Top-Line Scale</span></td>
      </tr>
      <tr>
        <td><strong>Dividend Yield</strong></td>
        {% for c_item in comp_list %}
          <td style="text-align: right; font-weight: 800; {{ 'color: #2563eb;' if c_item.ticker == cv.value_ticker else '' }}">{{ c_item.dividend_yield }}</td>
        {% endfor %}
        <td style="text-align: right;">2.5%</td>
        <td style="text-align: center;"><span class="tag-blue">Steady Payout</span></td>
      </tr>
      <tr>
        <td><strong>Workforce Headcount</strong></td>
        {% for c_item in comp_list %}
          <td style="text-align: right;">{{ c_item.headcount }}</td>
        {% endfor %}
        <td style="text-align: right;">Global Scale</td>
        <td style="text-align: center;"><span class="tag-blue">Delivery Reach</span></td>
      </tr>
      <tr>
        <td><strong>Voluntary LTM Attrition</strong></td>
        {% for c_item in comp_list %}
          <td style="text-align: right; font-weight: 700;">{{ c_item.attrition }}</td>
        {% endfor %}
        <td style="text-align: right;">13.0%</td>
        <td style="text-align: center;"><span class="tag-green">Normalized Churn</span></td>
      </tr>
    </tbody>
  </table>
{% else %}
  <table class="data-table">
    <thead>
      <tr>
        <th style="width: 25%;">Measured Ratio</th>
        <th style="width: 15%; text-align: right;">Reported Value</th>
        <th style="width: 15%; text-align: center;">Verdict Tag</th>
        <th style="width: 45%;">Metric Meaning &amp; Formula</th>
      </tr>
    </thead>
    <tbody>
      {% for row in report.financial.get('ratios_table', []) %}
        <tr>
          <td><strong>{{ row.metric }}</strong></td>
          <td style="text-align: right; font-weight: 800;">{{ row.reported }}</td>
          <td style="text-align: center;">
            <span class="{{ 'tag-green' if row.verdict_tag == 'GOOD' else ('tag-red' if row.verdict_tag == 'BAD' else 'tag-amber') }}">{{ row.verdict_tag or 'WATCH' }}</span>
          </td>

# --- Model provider (pick one; both are ₹0) ---
MODEL_PROVIDER=gemini                 # gemini | ollama
GEMINI_API_KEY=your-free-tier-key     # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BACKUP_KEYS=your-key-b,your-key-c   # optional; round-robin with the primary
GEMINI_MODEL_FAST=                   # optional cheap model for extraction roles (e.g. gemini-3.1-flash-lite)
# --- OpenRouter (free models; recommended) ---
# MODEL_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your-key
# OPENROUTER_API_KEY_BACKUP=sk-or-v1-your-second-key   # optional; round-robin with the primary
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free  # tools + structured outputs
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- AgentRouter (OpenAI-compatible gateway; DeepSeek single-shot + GLM tool loops) ---
# MODEL_PROVIDER=agentrouter
# AGENTROUTER_API_KEY=sk-your-agentrouter-key
# AGENTROUTER_MODEL=deepseek-v4-flash        # meta stages (analyzer/planner/challenger/synthesizer)
# AGENTROUTER_MODEL_TOOLS=glm-5.3            # specialist Crews (tool loops)
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# NOTE: this gateway allowlists known client User-Agents (handled in code as
# Claude-Desktop/1.0.0), has no response_format support (raw-JSON contracts),
# and its content filter rejects news.google.com/rss redirect URLs in prompts
# (scrubbed automatically; stored citations keep them).

# MODEL_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# --- Storage ---
SQLITE_PATH=data/jobs.sqlite
CHECKPOINT_DB=data/checkpoints.sqlite
FAISS_INDEX_DIR=data/faiss
DOCUMENTS_DIR=documents
REPORTS_DIR=reports

# --- Runtime ---
AGENT_TIMEOUT_S=120
MAX_AGENT_RETRIES=2
RETRIEVAL_TOP_K=5
